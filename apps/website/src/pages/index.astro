---
import { Picture } from 'astro:assets';

import userpic from '@/assets/userpic.png';
import Footer from '@/components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} class="flex flex-col">
  <main class="flex grow items-center">
    <div class="flex w-full flex-wrap items-start gap-8 sm:gap-16">
      <Picture
        src={userpic}
        width={416}
        height={416}
        widths={[288, 416]}
        sizes="(max-width: 640px) 144px, 208px"
        formats={['avif', 'webp']}
        class="box-content aspect-square w-36 shrink-0 rounded-full border border-neutral-700 sm:w-52"
        alt=""
      />
      <div class="mt-4 w-min min-w-[16rem] grow">
        <p>
          <span class="mr-2 text-2xl">👋</span> I'm Nazar, a Javascript software engineer that focuses
          on front end tools such as React and Typescript.
        </p>
        <p class="mt-4">
          My area of expertise is React ecosystem, but I also have experience in backend
          software development.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
