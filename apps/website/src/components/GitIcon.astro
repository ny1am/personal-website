---
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  width="16"
  height="16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['shrink-0', className]}
>
  <circle cx="4.5" cy="3" r="1.75"></circle>
  <circle cx="4.5" cy="13" r="1.75"></circle>
  <circle cx="11.5" cy="3" r="1.75"></circle>
  <path d="M4.5 4.75v6.5"></path>
  <path d="M11.5 4.75v1.9Q11.5 9 9.2 9H4.5"></path>
</svg>
